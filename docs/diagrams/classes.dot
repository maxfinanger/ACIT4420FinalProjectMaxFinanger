digraph classes {
  rankdir=TB; fontname="Helvetica"; nodesep=0.4; ranksep=0.5;
  node [shape=record, style=filled, fillcolor="#FFFFFF", fontname="Helvetica", fontsize=12, color="#555555"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  Marketplace [label="{Marketplace|companies, destinations\loffers, profiles, bookings\l|filter(request)\lsearch(request, weights)\lcompare_profiles(request)\lbook(offer, name)\l}", fillcolor="#D5EBD5"];
  TravelRequest [label="{TravelRequest|HARD: destination, dates,\l  max_budget, max_transfers,\l  require_changeable,\l  min_luggage_kg,\l  max_duration\lSOFT: preferred_departure,\l  profile\l}"];
  Registry [label="{criteria registry|@register_criterion(name)\l|price, duration, departure,\lflexibility, transfers,\lrating, emissions\l}", fillcolor="#EAF5EA"];
  Constraint [label="{\<\<abstract\>\>\nConstraint||is_active(request)\lis_satisfied(offer, request)\lreason(request)\l}", fillcolor="#E8F0FA"];
  Subs [label="{DestinationConstraint\lTravelWindowConstraint\lSeatsConstraint\lBudgetConstraint\lMaxTransfersConstraint\lMaxDurationConstraint\lLuggageConstraint\lFlexibilityConstraint\l}", fillcolor="#E8F0FA"];
  Ranked [label="{RankedOffer|offer\lcriterion_scores\lcontributions\ltotal_score, rank\ltie_broken\l}"];

  Subs -> Constraint [arrowhead=empty, label=" inherits"];
  Marketplace -> TravelRequest [style=dashed, label=" takes"];
  Marketplace -> Registry [arrowhead=odiamond, label=" via ranking"];
  Marketplace -> Constraint [arrowhead=odiamond, label=" uses many"];
  Marketplace -> Ranked [style=dashed, label=" returns"];
  {rank=same; TravelRequest; Registry; Constraint}
  {rank=same; Subs; Ranked}
}
