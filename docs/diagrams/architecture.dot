digraph architecture {
  rankdir=TB; fontname="Helvetica"; nodesep=0.35; ranksep=0.42; newrank=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, fillcolor="#FFFFFF", color="#555555"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  data   [label="Input files\ncompanies.csv\ndestinations.csv, offers.csv\nprofiles.json, scoring.json", fillcolor="#F2F2F2", color="#BBBBBB"];
  loader [label="loader.py\ntext to types, file errors", fillcolor="#E8F0FA", color="#9DB7D9"];
  validation [label="validation.py\nbusiness rules, regex", fillcolor="#E8F0FA", color="#9DB7D9"];
  logfile [label="logs/busbidder.log", fillcolor="#F2F2F2", color="#BBBBBB"];
  ui [label="cli.py / interactive.py\nthe traveller enters a request\nand chooses an offer", fillcolor="#F4E6F7", color="#B58AC0"];
  marketplace [label="marketplace.py\nMarketplace", fillcolor="#D5EBD5", color="#9CC79C"];
  filtering   [label="filtering.py\nHARD constraints", fillcolor="#EAF5EA", color="#9CC79C"];
  ranking     [label="ranking.py\nweighted score, ties, influence", fillcolor="#EAF5EA", color="#9CC79C"];
  criteria    [label="criteria.py\n@register_criterion\nSOFT criteria", fillcolor="#EAF5EA", color="#9CC79C"];
  explain     [label="explain.py, comparison.py\nexplanation, profile comparison", fillcolor="#EAF5EA", color="#9CC79C"];
  display [label="display.py\nranking and explanation as text", fillcolor="#F4E6F7", color="#B58AC0"];
  booking [label="booking.py\nBookingService", fillcolor="#FBF1E0", color="#E0BE85"];
  bookings [label="data/bookings.json", fillcolor="#F2F2F2", color="#BBBBBB"];

  data -> loader;
  loader -> validation [label=" raw rows"];
  validation -> logfile [label=" rejected rows", style=dashed];
  validation -> marketplace [label=" valid Offers"];
  ui -> marketplace [label=" TravelRequest"];
  marketplace -> filtering [label=" all offers"];
  filtering -> ranking [label=" acceptable offers"];
  ranking -> criteria [label=" score by name"];
  ranking -> explain [label=" RankedOffers"];
  explain -> display;
  display -> ui [style=dotted, label=" text shown", constraint=false];
  ui -> booking [label=" selected offer"];
  booking -> bookings [dir=both, label=" save / seats sold"];

  {rank=same; validation; logfile}
  {rank=same; ui; marketplace}
  {rank=same; ranking; criteria}
  {rank=same; filtering; booking}
  {rank=same; explain; bookings}
}
